```c
#include <stdio.h>
int main() {
    int n, a[10][10], v[10]={0}, i, j, e=0, min, x, y, cost=0;

    printf("Enter vertices: ");
    scanf("%d",&n);

    printf("Enter adjacency matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<n;j++) {
            scanf("%d",&a[i][j]);
            if(a[i][j]==0 && i!=j) a[i][j]=999;
        }

    v[0]=1;
    while(e<n-1) {
        min=999;
        for(i=0;i<n;i++)
            if(v[i])
                for(j=0;j<n;j++)
                    if(!v[j] && a[i][j]<min)
                        min=a[i][j], x=i, y=j;

        if(min==999) {
            printf("Graph is disconnected");
            return 0;
        }

        printf("%d - %d : %d\n",x,y,min);
        cost+=min;
        v[y]=1;
        e++;
    }
    printf("Minimum cost = %d",cost);
    return 0;
}
