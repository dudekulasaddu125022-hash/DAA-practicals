#include <stdio.h>

int a[12][12], visited[12], n;

void DFS(int v) {
    printf("%d ", v);
    visited[v] = 1;

    for (int i = 0; i < n; i++)
        if (a[v][i] && !visited[i])
            DFS(i);
}

void BFS(int start) {
    int q[20], front = 0, rear = 0;
    for (int i = 0; i < n; i++) visited[i] = 0;

    q[rear++] = start;
    visited[start] = 1;

    while (front < rear) {
        int v = q[front++];
        printf("%d ", v);

        for (int i = 0; i < n; i++)
            if (a[v][i] && !visited[i]) {
                q[rear++] = i;
                visited[i] = 1;
            }
    }
}

int main() {
    int e, u, v, start;

   printf("Enter vertices and edges: ");
    scanf("%d%d", &n, &e);

    printf("Enter edges (u v):\n");
    for (int i = 0; i < e; i++) {
        scanf("%d%d", &u, &v);
        a[u][v] = a[v][u] = 1;
    }
    printf("Enter starting vertex: ");
    scanf("%d", &start);

    printf("BFS: ");
    BFS(start);

    for (int i = 0; i < n; i++) visited[i] = 0;
    printf("\nDFS: ");
    DFS(start);

    return 0;
}
